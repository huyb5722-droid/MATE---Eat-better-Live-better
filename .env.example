# Tuỳ chọn cho quản trị viên: cần có để dùng API xuất dữ liệu.
# Để trống thì app vẫn chạy và người dùng vẫn đăng nhập được.
MATE_ADMIN_TOKEN=

# Cấu hình máy chủ trên máy của bạn.
PORT=4173
HOST=127.0.0.1

# Optional: server-side Google Places API key for nearby place results.
MATE_GOOGLE_MAPS_API_KEY=

# Optional: browser key for the embedded Google map. Restrict this key to Maps Embed API
# and the deployed website's HTTP referrers in Google Cloud Console.
MATE_GOOGLE_MAPS_EMBED_KEY=
